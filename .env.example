# Copy to .env and fill in. .env is gitignored; never commit real values.
# Scripts load .env with override=False, so real environment variables take precedence.
# In Colab, store the same names in the Secrets panel (key icon) instead.

# Hugging Face token. "Write" scope (or fine-grained: write access to your
# sql-create-context-clean dataset repo) to push the dataset; "Read" is enough for
# training/generation. Create at https://huggingface.co/settings/tokens
HF_TOKEN=

# Weights & Biases API key, used to log training runs. https://wandb.ai/authorize
WANDB_API_KEY=

# GitHub fine-grained PAT used only by notebooks/colab_runner.ipynb to clone the repo
# if it is private. Scope: this repository only, "Contents: Read-only".
# Leave empty while the repo is public.
GH_COLAB_TOKEN=
